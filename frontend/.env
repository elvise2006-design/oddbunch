# ---------------------------------------------------------------------------
# Seedling & Vine — frontend environment
# Copy to `.env.local` and edit. `.env` is committed as the working default.
# ---------------------------------------------------------------------------

# Single source of truth for the backend URL. The frontend never hardcodes it.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Demo cart / wishlist owner key sent with every request.
VITE_SESSION_ID=demo

# Dev server port (change if 5173 is already taken on your machine).
VITE_PORT=5173
